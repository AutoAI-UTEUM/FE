{
  "name": "edupilot-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:qa": "cross-env VITE_API_BASE_URL=/api VITE_API_CAPABILITIES=reports,password-reset,oauth,schedule,analytics VITE_DEV_PROXY_TARGET=mock npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "test:e2e:mock": "cross-env QA_ENV=mock playwright test",
    "test:e2e:dev": "cross-env QA_ENV=dev playwright test",
    "test:e2e:prod": "cross-env QA_ENV=prod playwright test",
    "test:e2e:visual": "cross-env QA_ENV=mock QA_FULL_MATRIX=1 playwright test --grep @visual",
    "test:performance:bundle": "node scripts/analyze-fe-performance.mjs",
    "test:qa:health": "node scripts/qa-health-probe.mjs",
    "test:qa:commercialization": "node scripts/prepare-commercialization-review.mjs",
    "test:qa:issues": "node scripts/report-qa-issues.mjs",
    "test:overnight": "node scripts/run-overnight-qa.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.0",
    "@blocknote/mantine": "^0.54.0",
    "@blocknote/react": "^0.54.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@mantine/utils": "^6.0.22",
    "@tailwindcss/vite": "4.1.13",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "7.18.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "^7.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
