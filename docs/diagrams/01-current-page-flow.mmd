  class LOGIN_API,EMAIL_CHECK,SIGNUP_API,PREF_API,AVATAR_API,JOIN,UPLOAD,MATERIAL_ACTION,SESSION_NEW,SESSION_DELETE,PAGE_API,CHAT,CONVERSATION,QUIZ_RESULT,CORRECTION,NOTE_API,EXAM_LIST,EXAM_SUBMIT,INVITE_API,CREATE_API,WEEK_UPLOAD,PUBLISH_WEEK,MATERIAL_MANAGE,EDIT_API,COMPLETE,NOTICE_API,REQUEST_LIST,REQUEST_API,EXAM_DRAFT,EXAM_ADMIN,FEEDBACK action;
  class FORGOT_LOCAL,GOOGLE_WAIT,CAL_LOCAL,WEEK_PARTIAL,STATUS_EMPTY partial;
